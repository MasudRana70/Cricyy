# =============================================
# CRICYY BACKEND – Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- MongoDB -----
# Local MongoDB (default):
MONGODB_URI=mongodb://127.0.0.1:27017/cricyy

# MongoDB Atlas (Free 512MB M0 Cluster) – use this for Vercel hosting:
# 1. Create free M0 cluster at https://www.mongodb.com/cloud/atlas
# 2. Network Access -> Add IP Address -> Allow Access from Anywhere (0.0.0.0/0)
# 3. Database Access -> Add Database User (save username & password)
# 4. Copy SRV connection string & set in Vercel -> Project Settings -> Environment Variables:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cricyy?retryWrites=true&w=majority

# ----- Uploads -----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
