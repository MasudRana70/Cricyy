# =============================================
# CRICYY BACKEND – Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- MongoDB -----
# Local MongoDB (default):
MONGODB_URI=mongodb://127.0.0.1:27017/cricyy

# MongoDB Atlas (cloud) example – uncomment and fill in:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cricyy?retryWrites=true&w=majority

# ----- Uploads -----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
